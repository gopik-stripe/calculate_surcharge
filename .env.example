# Copy this file to `.env` and fill in values. Never commit `.env`.

# Stripe Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# Stripe app remote endpoint signing secret (whsec_...) for calculate_surcharge when you enable verification
STRIPE_SURCHARGE_SIGNING_SECRET=

# Signing secret for verify_health remote function
HEALTH_SIGNING_SECRET=
